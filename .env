# Chatty Web Architect Backend Configuration
# Generated for quick development setup

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (using SQLite for quick setup)
DB_TYPE=sqlite
DB_PATH=./data/chatty_web_architect.db

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=your_key_id_here
VITE_RAZORPAY_KEY_SECRET=your_key_secret_here

# Payment System Configuration
VITE_PAYMENT_ENABLED=false
VITE_PAYMENT_PROVIDER=Payoneer
VITE_PAYMENT_TEST_MODE=false
VITE_PAYMENT_CURRENCY=INR
DB_NAME=chatty_web_architect
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Google Gemini Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAsNlJqfWyIJQOpkpyUV7uv7ACrzOjIBms

