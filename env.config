# Chatty Web Architect Backend Configuration
# Generated for quick development setup

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (using SQLite for quick setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatty_web_architect
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# OpenAI Configuration (you'll need to add your own key)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads 