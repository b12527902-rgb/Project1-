# Frontend Environment Variables
# Copy this file to .env.local and adjust as needed

# Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# JWT Authentication
VITE_JWT_EXPIRY=3600

# Development settings
VITE_APP_ENV=development

# Optional: Analytics and monitoring
VITE_ANALYTICS_ID=your_analytics_id
VITE_SENTRY_DSN=your_sentry_dsn 

# Real Google AdSense (replace with your real IDs)
# Publisher ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# Home page ad slots (create units in AdSense and paste their slot IDs)
VITE_ADSENSE_HOME_TOP_SLOT=
VITE_ADSENSE_HOME_MID_SLOT=
VITE_ADSENSE_HOME_BOTTOM_SLOT=
# Enhanced ad placements
VITE_ADSENSE_TOP_BANNER_SLOT=
VITE_ADSENSE_STICKY_SLOT=
VITE_ADSENSE_IN_ARTICLE_1_SLOT=
VITE_ADSENSE_IN_ARTICLE_2_SLOT=

# Media.net Configuration (additional ad network)
VITE_MEDIANET_ZONE_ID=

# Certified CMP configuration (required for EEA/UK). Choose provider and set the ID.
# Currently supported: "cookiebot"
VITE_CMP_PROVIDER=cookiebot
VITE_COOKIEBOT_ID=

# Email Service Configuration (for newsletter)
VITE_MAILCHIMP_API_KEY=
VITE_MAILCHIMP_LIST_ID=
VITE_CONVERTKIT_API_KEY=
VITE_CONVERTKIT_FORM_ID=

# Push Notification Service
VITE_ONESIGNAL_APP_ID=

# Advanced Monetization Features

# Short Links Monetization (AdFly, ShrinkEarn)
VITE_ADFLY_API_KEY=
VITE_ADFLY_USER_ID=
VITE_SHRINKEARN_API_KEY=

# Smart Affiliate Networks (Skimlinks, VigLink)
VITE_SKIMLINKS_PUBLISHER_ID=
VITE_VIGLINK_API_KEY=

# Data Monetization Services
VITE_NARRATIVE_API_KEY=
VITE_DATAUNION_API_KEY=

# Telegram/WhatsApp Channel IDs
VITE_TELEGRAM_CHANNEL_ID=
VITE_WHATSAPP_BUSINESS_ID=

# Engagement Analytics
VITE_HOTJAR_ID=
VITE_CRISP_CHAT_ID=
VITE_INTERCOM_APP_ID=

# Payment System Configuration
VITE_PAYMENT_ENABLED=false
VITE_PAYMENT_PROVIDER=none
VITE_PAYMENT_TEST_MODE=true
VITE_PAYMENT_CURRENCY=USD
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here